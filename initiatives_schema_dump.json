  "constraints": [
    {
      "name": "initiatives_approval_mandate_check",
      "definition": "CHECK ((approval_mandate = ANY (ARRAY['Cabinet Approved'::text, 'Ministerial Approved'::text, 'Board/Delegated'::text, 'Pre-Approval'::text])))"
    },
    {
      "name": "initiatives_funding_status_check",
      "definition": "CHECK ((funding_status = ANY (ARRAY['funded'::text, 'partially_funded'::text, 'not_funded'::text, 'pending'::text])))"
    },
    {
      "name": "initiatives_novelty_score_check",
      "definition": "CHECK (((novelty_score >= 1) AND (novelty_score <= 5)))"
    },
    {
      "name": "initiatives_org_id_fkey",
      "definition": "FOREIGN KEY (org_id) REFERENCES organizations(id) ON DELETE CASCADE"
    },
    {
      "name": "initiatives_owner_id_fkey",
      "definition": "FOREIGN KEY (owner_id) REFERENCES users(id) ON DELETE SET NULL"
    },
    {
      "name": "initiatives_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "initiatives_relative_priority_check",
      "definition": "CHECK ((relative_priority = ANY (ARRAY['Tier 1'::text, 'Tier 2'::text, 'Tier 3'::text])))"
    },
    {
      "name": "initiatives_strategic_pillar_id_fkey",
      "definition": "FOREIGN KEY (strategic_pillar_id) REFERENCES strategic_pillars(id)"
    }
  ],
  "policies": [
    {
      "schemaname": "public",
      "tablename": "initiatives",
      "policyname": "View initiatives",
      "permissive": "PERMISSIVE",
      "roles": "{public}",
      "cmd": "SELECT",
      "qual": "(org_id = get_auth_user_org_id())",
      "with_check": null
    },
    {
      "schemaname": "public",
      "tablename": "initiatives",
      "policyname": "Propose initiatives",
      "permissive": "PERMISSIVE",
      "roles": "{public}",
      "cmd": "INSERT",
      "qual": null,
      "with_check": "(org_id = get_auth_user_org_id())"
    },
    {
      "schemaname": "public",
      "tablename": "initiatives",
      "policyname": "Update own proposed initiatives",
      "permissive": "PERMISSIVE",
      "roles": "{public}",
      "cmd": "UPDATE",
      "qual": "((org_id = get_auth_user_org_id()) AND (owner_id = auth.uid()) AND (status = 'proposed'::text))",
      "with_check": null
    },
    {
      "schemaname": "public",
      "tablename": "initiatives",
      "policyname": "Chair/Admin manage all initiatives",
      "permissive": "PERMISSIVE",
      "roles": "{public}",
      "cmd": "UPDATE",
      "qual": "((org_id = get_auth_user_org_id()) AND (EXISTS ( SELECT 1\n   FROM user_roles\n  WHERE ((user_roles.user_id = auth.uid()) AND (user_roles.organization_id = initiatives.org_id) AND (user_roles.role = ANY (ARRAY['chair'::text, 'admin'::text]))))))",
      "with_check": null
    }
  ]
}